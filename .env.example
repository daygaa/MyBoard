# MyBoard — Variables d'environnement
#
# COPIE ce fichier vers ".env" et adapte si besoin :
#   cp .env.example .env      (Linux/macOS)
#   copy .env.example .env    (Windows PowerShell)
#
# Le chemin est RELATIF au fichier prisma/schema.prisma.
# "../library/library.db" = remonte d'un dossier (de prisma/ vers la racine) puis entre dans library/.
# Ça marche sur Windows, macOS et Linux sans modification.

DATABASE_URL="file:../library/library.db"
